rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test collection for connection health check
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Simplified for debugging - allow list/get if user is the owner
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow collector to read as well
      allow read: if isSignedIn() && resource.data.collectorId == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.collectorId == request.auth.uid ||
        request.resource.data.collectorId == request.auth.uid
      );
    }

    // --- Prices Collection ---
    match /prices/{priceId} {
      allow read: if true;
    }

    // Global Safety Net (at the bottom)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
  }
}
