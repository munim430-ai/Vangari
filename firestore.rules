rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'name', 'phone', 'role', 'points', 'badges', 'referralCode', 'address', 'createdAt']) &&
               data.keys().size() == 10 &&
               data.uid == request.auth.uid &&
               data.role in ['user', 'collector', 'admin'] &&
               data.points == 0 &&
               data.createdAt == request.time;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'points', 'badges', 'referralCode']) &&
                      (incoming().role == existing().role); // Prevent role escalation
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.userId == request.auth.uid &&
               data.status == 'pending' &&
               data.createdAt == request.time;
      }

      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.collectorId == request.auth.uid);
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // User cancelling their own order
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled') ||
        // Collector accepting or updating order
        (incoming().collectorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAll(['collectorId', 'status']))
      );
    }

    // --- Prices Collection (Read-only for public) ---
    match /prices/{priceId} {
      allow read: if true;
      allow write: if false; // Only via admin (manual or cloud function)
    }
  }
}
