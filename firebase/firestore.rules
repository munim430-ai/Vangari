rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'munimm247@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, update: if isAdmin() || isOwner(userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId) || resource.data.collectorId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.userId) || resource.data.collectorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /collectors/{collectorId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pricing/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if true;
      allow update, delete: if isAdmin();
    }
  }
}
